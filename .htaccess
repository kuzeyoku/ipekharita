<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to sensitive files & config
    RedirectMatch 403 (?i)\.(env|git|htaccess|config)$
    RedirectMatch 403 (?i)/(composer\.json|composer\.lock|package\.json|artisan)$

    # 2. Force HTTPS cleanly without exposing /public/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 3. Strip /public/ if explicitly typed in the browser address bar
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 4. Transparently route root traffic to public/
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
